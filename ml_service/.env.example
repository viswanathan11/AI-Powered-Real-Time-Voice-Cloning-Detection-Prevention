# VoiceShield ML Service Configuration

HOST=0.0.0.0
PORT=8000
DEBUG=false
DEVICE=cpu

# Model settings
ECAPA_MODEL_SOURCE=speechbrain/spkrec-ecapa-voxceleb
ECAPA_SAVEDIR=./models/checkpoints/ecapa_tdnn
WAVLM_MODEL_ID=microsoft/wavlm-base
WAVLM_SAVEDIR=./models/checkpoints/wavlm

# Risk Engine weights & thresholds
SYNTHETIC_WEIGHT=0.5
SPEAKER_MISMATCH_WEIGHT=0.5
SYNTHETIC_SCORE_THRESHOLD=0.65
